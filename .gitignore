# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .env.example documents every key and is committed; must come after `.env*`
!.env.example

# pnpm store, if ever created in-repo
.pnpm-store/

# Claude Code: personal settings only (settings.json and launch.json stay tracked)
.claude/settings.local.json

# editors
.idea/
.vscode/*
!.vscode/extensions.json
